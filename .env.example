# Database Connection
# SQLite for local development:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production deployment (Supabase, Neon, AWS RDS, Railway):
# DATABASE_URL="postgresql://username:password@host:5432/ufy_db?sslmode=require"

# Authentication & Session Security (Generate a secure 64-char string for production)
JWT_SECRET="replace-with-a-random-secure-secret-string-at-least-32-chars"

# Initial Administrator Provisioning
INITIAL_ADMIN_EMAIL="admin@ufy.org"
INITIAL_ADMIN_PASSWORD="ChooseAStrongPassword123!"
INITIAL_ADMIN_NAME="UFY Lead Administrator"

# Application Base URL
NEXT_PUBLIC_APP_URL="https://ufy.org"

# Optional Email Integration
# SMTP_HOST="smtp.provider.com"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="secret-key"
# SMTP_FROM="community@ufy.org"

# Optional Cloud Storage (Supabase Storage)
# STORAGE_PROVIDER="supabase"
# SUPABASE_URL="https://xyz.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
# SUPABASE_STORAGE_BUCKET="ufy-media"
